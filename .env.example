# Jetstream base URL (no /subscribe suffix; @atcute/jetstream appends it)
FIREHOSE_URL=wss://jetstream2.us-east.bsky.network
CURSOR_FILE=./data/cursor.txt

# Classifier
MODEL_DIR=./model/onnx
# Use model.int8.onnx for CPU-only deployments.
MODEL_FILE=model.onnx
THRESHOLD=0.85
BATCH_SIZE=64
FLUSH_MS=25
MAX_QUEUE=20000
PROVIDER=auto

# Labels
LABEL_VALUE=us-politics
LABEL_DB=./data/labels.db
LABELS_NDJSON=./data/labels.ndjson
METRICS_PORT=4103

# Signed labeler service (@atcute/labeler). Leave DID/SIGNING_KEY unset for a
# local, unsigned run that only writes SQLite + NDJSON.
# DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx
# SIGNING_KEY=64_hex_characters
# DID returned at /.well-known/atproto-did for custom-handle verification.
# Defaults to DID when unset.
# WELL_KNOWN_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx
PORT=4102
